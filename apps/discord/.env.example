# Copie ce fichier en .env (ignoré par git) et remplis-le.

# Jeton du bot (Developer Portal > Bot > Reset Token). Sert uniquement à `pnpm commandes`,
# jamais au Worker : `wrangler dev` ne charge que les secrets déclarés dans wrangler.jsonc.
DISCORD_TOKEN=

# Clé publique (General Information > Public Key), pour `wrangler dev` seulement. En production,
# c'est un secret du Worker : wrangler secret put DISCORD_PUBLIC_KEY.
DISCORD_PUBLIC_KEY=
