{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mordieu-discord",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "ai": { "binding": "AI", "remote": true },
  // Secrets du Worker (wrangler secret put), jamais dans ce fichier : `wrangler deploy` échoue tant
  // qu'il en manque un. En local, `wrangler dev` les lit dans .env.
  "secrets": {
    // Clé publique de l'application (Developer Portal > General Information > Public Key).
    "required": ["DISCORD_PUBLIC_KEY"]
  }
}
